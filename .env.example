# Copy this file to .env and fill in real values. The .env file is gitignored.

# Groq AI (https://console.groq.com)
# Free tier: 30 RPM, 1000 RPD, Llama 3.3 70B
GROQ_API_KEY=gsk_your_groq_api_key_here

# AI provider switch (groq | simple). Defaults to groq if GROQ_API_KEY set.
AI_PROVIDER=groq

# Robot account password used by the bundled robot service
ROBOT_PASSWORD=robot123
